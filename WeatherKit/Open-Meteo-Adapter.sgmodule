#!name = Open-Meteo 分钟降水翻译器
#!desc = 拦截 WeatherKit v3 脚本对彩云 minutely 接口的请求，转调免费 Open-Meteo API。解决公共 Key 限流导致小时降水面板时有时无的问题。需配合 v3 版 WeatherKit 模块使用。
#!author = Colin
#!homepage = https://github.com/Louis-os/hark-gasprice
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!version = 1.0.0

[Script]
Open-Meteo-Minutely-Adapter = type=http-response, pattern=^https?:\/\/api\.caiyunapp\.com\/v2\.6\/, script-path=https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/open-meteo-adapter.js, requires-body=true, timeout=30

[MITM]
hostname = %APPEND% api.caiyunapp.com
