#!name =  iRingo: 🌤 WeatherKit v3
#!desc = v3.3.2，可选彩云/和风数据源
#!author = VirgilClyne,WordlessEcho,001ProMax
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!version = 3.3.2

[Argument]
Weather.Provider = select,"ColorfulClouds","QWeather","WeatherKit",tag=[天气] 数据源,desc=使用选定的数据源替换天气数据。
NextHour.Provider = select,"ColorfulClouds","QWeather","WeatherKit",tag=[未来一小时降水强度] 数据源,desc=使用选定的数据源填充未来一小时降水强度的数据。
API.ColorfulClouds.Token = input,"",tag=[API] 彩云天气令牌,desc=彩云天气 API 令牌，不填则使用内置公共 Key
API.QWeather.Host = input,"",tag=[API] 和风天气主机,desc=和风天气 API 专属主机名（如 p75cttwft8.re.qweatherapi.com）
API.QWeather.Token = input,"",tag=[API] 和风天气令牌,desc=和风天气 API 令牌
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
DOMAIN,tether.edge.apple,REJECT-DROP

[Script]
http-response ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ requires-body=1, script-path=https://raw.githubusercontent.com/Louis-os/hark-gasprice/refs/heads/main/WeatherKit/response.bundle.js, tag=🌤 WeatherKit.v3.availability.response, argument=Weather.Provider={Weather.Provider}&NextHour.Provider={NextHour.Provider}&API.ColorfulClouds.Token={API.ColorfulClouds.Token}&API.QWeather.Host={API.QWeather.Host}&API.QWeather.Token={API.QWeather.Token}&LogLevel={LogLevel}
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/ script-path=https://raw.githubusercontent.com/Louis-os/hark-gasprice/refs/heads/main/WeatherKit/request.bundle.js, tag=🌤 WeatherKit.v3.airQualityScale.request, argument=Weather.Provider={Weather.Provider}&NextHour.Provider={NextHour.Provider}&API.ColorfulClouds.Token={API.ColorfulClouds.Token}&API.QWeather.Host={API.QWeather.Host}&API.QWeather.Token={API.QWeather.Token}&LogLevel={LogLevel}
http-response ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Louis-os/hark-gasprice/refs/heads/main/WeatherKit/response.bundle.js, tag=🌤 WeatherKit.v3.weather.response, argument=Weather.Provider={Weather.Provider}&NextHour.Provider={NextHour.Provider}&API.ColorfulClouds.Token={API.ColorfulClouds.Token}&API.QWeather.Host={API.QWeather.Host}&API.QWeather.Token={API.QWeather.Token}&LogLevel={LogLevel}

[MITM]
hostname = weatherkit.apple.com
