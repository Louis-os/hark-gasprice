#!name = WeatherKit功能增強@NSRingo 解鎖蘋果天氣
#!desc = 解鎖全部天氣功能、修改空氣質量/下一小時降水/天氣數據/預警數據（原作者 NSRingo v3.3.2，JS 已鏡像到本倉庫）
#!category = NSRingo
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!author = VirgilClyne,WordlessEcho,001ProMax,hhh2210
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT
DOMAIN-SUFFIX,tthr.apple.com,REJECT
DOMAIN,tether.edge.apple,REJECT

[Rewrite]
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ url script-response-body https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/response.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/ url script-request-header https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/request.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$) url script-echo-response https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/request.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$) url script-echo-response https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/request.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ url script-response-body https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/response.bundle.js

[MITM]
hostname = weatherkit.apple.com
