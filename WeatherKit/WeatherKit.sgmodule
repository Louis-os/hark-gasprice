#!name=WeatherKit功能增强@NSRingo
#!desc=解锁苹果天气（JS 已自托管到本仓库，不再依赖原作者地址）
#!author=VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210]
#!icon=https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category=NSRingo
#!openUrl=http://boxjs.com/#/app/iRingo.WeatherKit
#!homepage=https://NSRingo.github.io/guide/Weather/weather-kit
#!date=2026-08-29 08:12:58
#!version=3.3.2

[Rule]
#[filter_local]
DOMAIN,weather-analytics-events.apple.com,REJECT
DOMAIN-SUFFIX,tthr.apple.com,REJECT
DOMAIN,tether.edge.apple,REJECT

[Script]
# 🌤 WeatherKit.api.v1.availability.response
response.bundle = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/, script-path=https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/response.bundle.js, requires-body=true, max-size=-1, timeout=60

# 🌤 WeatherKit.api.v1.airQualityScale.request
request.bundle = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, script-path=https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/request.bundle.js, timeout=60

# 🌤 WeatherKit.api.v1.weatherAlerts.response
request.bundle = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$), script-path=https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/request.bundle.js, timeout=60

request.bundle = type=http-request, pattern="^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$)", script-path=https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/request.bundle.js, timeout=60

# 🌤 WeatherKit.api.v2.weather.response
response.bundle = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/, script-path=https://cdn.jsdelivr.net/gh/Louis-os/hark-gasprice@main/WeatherKit/response.bundle.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% weatherkit.apple.com
