#!name = WeatherKit功能增强@NSRingo 解锁苹果天气
#!desc = 解锁全部天气功能、修改空气质量/下一小时降水/天气数据/预警数据（原作者 NSRingo v3.3.2）
#!category = NSRingo
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!author = VirgilClyne,WordlessEcho,001ProMax,hhh2210
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT
DOMAIN-SUFFIX,tthr.apple.com,REJECT
DOMAIN,tether.edge.apple,REJECT

[Rewrite]
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ url script-response-body https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/response.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/ url script-request-header https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$) url script-echo-response https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$) url script-echo-response https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/request.bundle.js
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ url script-response-body https://github.com/NSRingo/WeatherKit/releases/download/v3.3.2/response.bundle.js

[MITM]
hostname = weatherkit.apple.com
